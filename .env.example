# ------------------------------------------------------------------
# Smart Incident & Log Diagnostics Engine - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- LLM provider ---
# Selects which Spring AI chat model to enable: openai | ollama | none
SPRING_AI_MODEL_CHAT=openai

# OpenAI (or any OpenAI-compatible gateway, e.g. Azure / vLLM / Ollama's /v1 endpoint)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama (used when SPRING_AI_MODEL_CHAT=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1

# --- Application ---
SERVER_PORT=8080
INCIDENT_CACHE_TTL=24h
